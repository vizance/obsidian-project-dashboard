{
  "name": "obsidian-project-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Year-at-a-glance project dashboard for Obsidian project notes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
